# ─────────────────────────────────────────────────────────────────────────────
# TalentPulse — variables d'environnement (à définir dans Vercel > Settings > Environment Variables)
# Chaque fonctionnalité s'active seule quand ses variables existent (voir GET /api/health).
# Sans aucune variable optionnelle, le site fonctionne comme aujourd'hui : recherche + espace local.
# Ne JAMAIS committer de vraies valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sources d'offres (déjà configurées en production) ──
FT_CLIENT_ID=            # France Travail (francetravail.io), application « API Offres d'emploi v2 »
FT_CLIENT_SECRET=
ADZUNA_APP_ID=           # developer.adzuna.com (gratuit)
ADZUNA_APP_KEY=
# LBA_API_KEY=           # La Bonne Alternance (api.apprentissage.beta.gouv.fr) — pas encore branchée

# ── Comptes, favoris et suivi synchronisés (nécessite les DEUX) ──
DATABASE_URL=            # Neon Postgres (intégration Vercel Marketplace > Neon). Ex. postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=             # 32+ caractères aléatoires : `openssl rand -base64 48`. Signe les cookies de session.
# APP_ORIGIN=https://talentpulse.fr   # origines supplémentaires autorisées (domaine personnalisé), séparées par des virgules
# APP_URL=https://talentpulse-topaz.vercel.app   # URL publique utilisée dans les emails

# ── Lettre de motivation par IA (Vercel AI Gateway) ──
# Option A (recommandée sur Vercel) : OIDC automatique, il suffit d'activer explicitement :
# AI_LETTER_ENABLED=1
# Option B : clé AI Gateway (Vercel > AI Gateway > API Keys), utile aussi en local :
# AI_GATEWAY_API_KEY=
# AI_MODEL=google/gemini-3.1-flash-lite   # modèle par défaut (rapide et économique)

# ── Alertes quotidiennes (Vercel Cron, 1×/jour) ──
CRON_SECRET=             # 16+ caractères aléatoires ; Vercel l'envoie automatiquement au cron
RESEND_API_KEY=          # resend.com — email
ALERTS_FROM_EMAIL=       # ex. "TalentPulse <alertes@votre-domaine.fr>" (domaine vérifié dans Resend)

# ── Canal WhatsApp optionnel (Twilio) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886      # numéro WhatsApp Twilio (sandbox ou expéditeur approuvé)
# TWILIO_WHATSAPP_CONTENT_SID=           # modèle WhatsApp approuvé (obligatoire hors fenêtre de 24 h)
