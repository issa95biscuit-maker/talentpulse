{
  "rewrites": [
    { "source": "/offres", "destination": "/index.html" },
    { "source": "/offres/:path*", "destination": "/index.html" },
    { "source": "/offre/:path*", "destination": "/index.html" },
    { "source": "/lettre", "destination": "/index.html" },
    { "source": "/conseils", "destination": "/index.html" },
    { "source": "/mon-espace", "destination": "/index.html" },
    { "source": "/connexion", "destination": "/index.html" },
    { "source": "/mentions-legales", "destination": "/index.html" },
    { "source": "/confidentialite", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
